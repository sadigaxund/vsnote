# Copy to .env (repo root, next to docker-compose.yml) and edit. This is the
# COMPOSE env file — distinct from server/.env.example, which documents the
# same VSNOTE_*/CF_ACCESS_* variables for a local (non-Docker) `npm run
# server`. Every variable here maps 1:1 to one server/app/config.py setting
# via docker-compose.yml's `environment:` block; see that file's inline
# comments for exactly how each one is wired through and its fallback if
# left unset/uncommented. Secrets belong ONLY here (or real environment
# variables) — never in the image, never committed.

# --- container / port -------------------------------------------------
# Host-side port docker publishes (left-hand side of docker-compose.yml's
# `ports:` mapping). Change this if 8787 is already taken on the host —
# that's exactly what it's for.
VSNOTE_HOST_PORT=8787
# In-container bind port (right-hand side of the same mapping, and what
# uvicorn actually binds to inside the container). Only change this if you
# also have a specific reason to move it off the project-wide-reserved 8787.
VSNOTE_PORT=8787

# dev | prod. compose defaults this to "prod" (unlike server/.env.example's
# local-dev default of "dev") because VSNOTE_SECRET_KEY below becomes
# REQUIRED once this is "prod" — a real deployment shouldn't run with an
# ephemeral, restart-invalidated signing key.
VSNOTE_ENV=prod

# REQUIRED when VSNOTE_ENV=prod (the compose default above). Signs session
# cookies (app login + per-share password sessions). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VSNOTE_SECRET_KEY=

# Cloudflare Access team domain + expected audience tag — see
# server/README.md's "Cloudflare Access production topology" section.
# Leave both unset to disable Cf-Access JWT verification entirely (never an
# implicit allow).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Session cookies use Secure by default (real HTTPS, e.g. behind any
# reverse proxy or tunnel). Set False ONLY to test over plain http://localhost —
# never in anything resembling production.
VSNOTE_COOKIE_SECURE=True

# Max accepted blob size for POST /api/blobs and PUT /share/{id} (bytes).
VSNOTE_MAX_BLOB_BYTES=5242880

# slowapi/`limits`-syntax strings ("N/period"). *_SHARE_AUTH is the
# stricter brute-force throttle on POST /share/{id}/auth and
# POST /api/auth/login.
VSNOTE_RATE_LIMIT_DEFAULT=120/minute
VSNOTE_RATE_LIMIT_SHARE=60/minute
VSNOTE_RATE_LIMIT_SHARE_AUTH=5/minute

# App session + per-share password session lifetime, minutes.
VSNOTE_SESSION_TTL_MIN=30

# Phase 17 app-wide login gate (see server/.env.example for the full note).
# True (the default) gates the app shell once a credential path exists (a
# local account or CF_ACCESS_* above); with neither, nothing is gated.
VSNOTE_REQUIRE_LOGIN=True

# --- storage paths (advanced — both already point at the container's
# named volumes by default; only change these if you also change the
# matching `volumes:` mount in docker-compose.yml) ---
# VSNOTE_DB_URL=sqlite:////data/db/vsnote.db
# VSNOTE_GIT_ROOT=/data/git-repos

# --- server-mounted vault (Phase 17) ------------------------------------
# Unset (default): no change from Phase 11/14 — the vault is just the
# ordinary bare repo under VSNOTE_GIT_ROOT above, created on demand.
# Uncomment (and uncomment the matching `vsnote-vault` volume in
# docker-compose.yml) to make the vault a real, non-bare, plaintext
# working tree the server keeps in sync with pushes AND that's directly
# readable/editable via the volume from outside the container. An
# existing repo already at the mount is always respected — nothing
# auto-creates or overwrites it; a fresh mount needs one explicit
# POST /api/vault/init call (session-authenticated) before it's usable —
# see server/README.md's "Server-mounted vault" section.
# VSNOTE_VAULT_PATH=/data/vault
# The repo name clients use in <origin>/git/<name>.git to reach the vault.
# Only change together with the client's own "Repository name" setting.
VSNOTE_VAULT_REPO_NAME=vault

# --- mirroring to external remotes (Phase 17 Milestone B) ---------------
# SERVER-SIDE-ONLY credential storage (SSH keys, HTTPS tokens, known_hosts)
# for mirroring the vault to external remotes (GitHub/GitLab/Gitea/any),
# configured via the owner-only /api/vault/remotes API (session-
# authenticated, same as everything else under Settings). Already points at
# the container's named volume by default; only change together with the
# matching `volumes:` mount in docker-compose.yml. Nothing here is ever
# baked into the image — see server/README.md's "Mirroring to external
# remotes" section for how to add a remote, SSH key vs token, and what is
# (and is never) logged.
# VSNOTE_SECRETS_PATH=/data/secrets

# --- fallback-login onboarding (Phase 12) -------------------------------
# Set BOTH together to create one admin account on first boot (only if the
# users table is completely empty — safe to leave set across restarts, see
# server/README.md's "Fallback-login onboarding" section). Leave both unset
# to skip this entirely and use server/scripts/create_user.py instead
# (docker compose exec vsnote python server/scripts/create_user.py).
VSNOTE_BOOTSTRAP_USER=
VSNOTE_BOOTSTRAP_PASSWORD=
