# Copy to .env (repo root, next to docker-compose.yml) and edit. This is the
# COMPOSE env file — distinct from server/.env.example, which documents the
# same SLATE_*/CF_ACCESS_* variables for a local (non-Docker) `npm run
# server`. Every variable here maps 1:1 to one server/app/config.py setting
# via docker-compose.yml's `environment:` block; see that file's inline
# comments for exactly how each one is wired through and its fallback if
# left unset/uncommented. Secrets belong ONLY here (or real environment
# variables) — never in the image, never committed.

# --- container / port -------------------------------------------------
# Host-side port docker publishes (left-hand side of docker-compose.yml's
# `ports:` mapping). Change this if 8787 is already taken on the host —
# that's exactly what it's for.
SLATE_HOST_PORT=8787
# In-container bind port (right-hand side of the same mapping, and what
# uvicorn actually binds to inside the container). Only change this if you
# also have a specific reason to move it off the project-wide-reserved 8787.
SLATE_PORT=8787

# dev | prod. compose defaults this to "prod" (unlike server/.env.example's
# local-dev default of "dev") because SLATE_SECRET_KEY below becomes
# REQUIRED once this is "prod" — a real deployment shouldn't run with an
# ephemeral, restart-invalidated signing key.
SLATE_ENV=prod

# REQUIRED when SLATE_ENV=prod (the compose default above). Signs session
# cookies (app login + per-share password sessions). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SLATE_SECRET_KEY=

# Cloudflare Access team domain + expected audience tag — see
# server/README.md's "Cloudflare Access production topology" section.
# Leave both unset to disable Cf-Access JWT verification entirely (never an
# implicit allow).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Session cookies use Secure by default (real HTTPS, e.g. behind a
# Cloudflare tunnel). Set False ONLY to test over plain http://localhost —
# never in anything resembling production.
SLATE_COOKIE_SECURE=True

# Max accepted blob size for POST /api/blobs and PUT /share/{id} (bytes).
SLATE_MAX_BLOB_BYTES=5242880

# slowapi/`limits`-syntax strings ("N/period"). *_SHARE_AUTH is the
# stricter brute-force throttle on POST /share/{id}/auth and
# POST /api/auth/login.
SLATE_RATE_LIMIT_DEFAULT=120/minute
SLATE_RATE_LIMIT_SHARE=60/minute
SLATE_RATE_LIMIT_SHARE_AUTH=5/minute

# App session + per-share password session lifetime, minutes.
SLATE_SESSION_TTL_MIN=30

# --- storage paths (advanced — both already point at the container's
# named volumes by default; only change these if you also change the
# matching `volumes:` mount in docker-compose.yml) ---
# SLATE_DB_URL=sqlite:////data/db/slate.db
# SLATE_GIT_ROOT=/data/git-repos

# --- fallback-login onboarding (Phase 12) -------------------------------
# Set BOTH together to create one admin account on first boot (only if the
# users table is completely empty — safe to leave set across restarts, see
# server/README.md's "Fallback-login onboarding" section). Leave both unset
# to skip this entirely and use server/scripts/create_user.py instead
# (docker compose exec vsnote python server/scripts/create_user.py).
SLATE_BOOTSTRAP_USER=
SLATE_BOOTSTRAP_PASSWORD=

# --- optional cloudflared sidecar (see docker-compose.yml's commented-out
# `cloudflared` service) ---
# CLOUDFLARE_TUNNEL_TOKEN=
