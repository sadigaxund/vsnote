{
  "name": "vsnote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "server": "server/.venv/bin/python -m uvicorn app.main:app --reload --port 8787 --app-dir server --proxy-headers --forwarded-allow-ips='*'",
    "test:unit": "vitest run",
    "test:e2e": "VSNOTE_DEMO_VAULT=1 VSNOTE_SHARE_PROXY_TARGET=http://127.0.0.1:8788 vite build && VSNOTE_SHARE_PROXY_TARGET=http://127.0.0.1:8788 playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "skills:update": "node scripts/update-skill-references.mjs",
    "skills:update:latest": "node scripts/update-skill-references.mjs --latest"
  },
  "dependencies": {
    "@atomic-editor/editor": "^0.6.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@isomorphic-git/lightning-fs": "^4.7.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "buffer": "^6.0.3",
    "diff3": "^0.0.3",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.41.4",
    "lucide-react": "^0.545.0",
    "material-icon-theme": "^5.37.0",
    "my-you-eye": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "AGPL-3.0-only"
}
