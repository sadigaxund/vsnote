# Copy to server/.env and edit. Every variable has a sane dev default (see
# app/config.py) — this file documents what's tunable and why. Loaded by
# pydantic-settings via SettingsConfigDict(env_file=".env") relative to the
# CWD the process is started from (server/ when run via `npm run server`).

# dev | prod. Only gates whether SLATE_SECRET_KEY is required — nothing else
# in the app treats "dev" as an implicit trust signal.
SLATE_ENV=dev

# SQLAlchemy URL. SQLite is the only backend exercised this phase.
SLATE_DB_URL=sqlite:///./slate.db

# REQUIRED when SLATE_ENV=prod. Signs session cookies (app login + per-share
# password sessions) and API-token-adjacent HMACs. In dev, if unset, a loud
# RuntimeWarning is printed and an ephemeral per-process key is generated —
# every restart invalidates all sessions, and it must never be used for a
# real or multi-worker deployment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SLATE_SECRET_KEY=

# Comma-separated. CORS is applied ONLY to /api/* (never /share/*), never a
# wildcard, always allow_credentials=True. Defaults to the Slate SPA's own
# dev preview origins.
SLATE_CORS_ORIGINS=http://127.0.0.1:5290,http://localhost:5290

# uvicorn's bind port for `npm run server`. Do not change without also
# updating the root package.json "server" script and vite's dev-proxy config
# (Phase 10) — 8787 is reserved for this backend across the project.
SLATE_PORT=8787

# Cloudflare Access team domain + expected audience tag, e.g.
#   CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
#   CF_ACCESS_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave both unset for local dev — the Cf-Access-Jwt-Assertion verification
# path is then simply unavailable (never an implicit allow). See
# README.md's "Cloudflare Access production topology" section.
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Max accepted blob size for POST /api/blobs and PUT /share/{id} (bytes).
SLATE_MAX_BLOB_BYTES=5242880

# Phase 11 (real sync) — where bare git repos live, one directory per repo
# name (`{SLATE_GIT_ROOT}/{repo}.git`), created on demand on first
# authenticated push. Relative paths resolve against the CWD the process is
# started from (server/ via `npm run server`), same convention as
# SLATE_DB_URL's sqlite path above.
SLATE_GIT_ROOT=./git-repos

# slowapi/`limits`-syntax strings ("N/period"). rate_limit_share_auth is the
# stricter brute-force throttle applied to POST /share/{id}/auth AND
# POST /api/auth/login.
SLATE_RATE_LIMIT_DEFAULT=120/minute
SLATE_RATE_LIMIT_SHARE=60/minute
SLATE_RATE_LIMIT_SHARE_AUTH=5/minute

# App session + per-share password session lifetime, minutes.
SLATE_SESSION_TTL_MIN=30

# Session cookies use Secure by default (real HTTPS deployments). Set False
# ONLY to test over plain http:// locally — never in anything resembling
# production.
SLATE_COOKIE_SECURE=True
